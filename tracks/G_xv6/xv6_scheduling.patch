diff --git a/user/schedbench.c b/user/schedbench.c
new file mode 100644
index 0000000..c9cb2c3
--- /dev/null
+++ b/user/schedbench.c
@@ -0,0 +1,188 @@
+// schedbench POLICY WORKLOAD : scheduler benchmark (Track G). Output lines start with "R ".
+//   share : 3 CPU-bound processes with 30/20/10 tickets, fixed wall duration -> CPU shares
+//   mixed : 2 CPU hogs + 1 interactive process (short bursts + sleep)       -> wake-up delay and throughput
+//   jobs  : 6 CPU jobs of different lengths started together                 -> turnaround and response times
+// Time unit = timer ticks (10 ms). CPU work is counted in loop iterations, calibrated to ticks of solo CPU time.
+#include "kernel/types.h"
+#include "kernel/pstat.h"
+#include "user/user.h"
+
+static volatile int sink;
+static int iters_per_tick;
+
+static void
+spin(int n)               // n loop iterations of useless work
+{
+  int x = 1;
+  for (int i = 0; i < n; i++)
+    x = x * 31 + i;
+  sink = x;
+}
+
+static void
+calibrate(void)           // solo process: measure iterations per tick
+{
+  int t0 = uptime();
+  while (uptime() == t0)
+    ;
+  t0 = uptime();
+  int n = 0;
+  while (uptime() - t0 < 20) {
+    spin(20000);
+    n += 20000;
+  }
+  iters_per_tick = n / 20;
+}
+
+// One work unit = a FIXED number of loop iterations (about one 10 ms tick of solo CPU on this host), identical for every
+// policy. Self-calibrating per run was rejected: QEMU's JIT warm-up made the calibration vary 3.4M-5.3M between runs.
+#define WORK_UNIT 4000000
+
+static void
+spin_ticks(int t)         // t work units of CPU work
+{
+  for (int i = 0; i < t; i++)
+    spin(WORK_UNIT);
+}
+
+static struct pstat st;
+
+static int
+getrticks(void)           // CPU ticks consumed by the calling process
+{
+  getpinfo(&st);
+  int me = getpid();
+  for (int i = 0; i < PSTAT_NPROC; i++)
+    if (st.inuse[i] && st.pid[i] == me)
+      return (int)st.rticks[i];
+  return -1;
+}
+
+static void
+workload_share(void)
+{
+  int tick[3] = {30, 20, 10};
+  int fds[3][2];
+  int T = 600;                                   // 6 s of wall time
+  int start = uptime();
+  for (int k = 0; k < 3; k++) {
+    pipe(fds[k]);
+    if (fork() == 0) {
+      settickets(tick[k]);
+      long iters = 0;
+      while (uptime() - start < T) {
+        spin(10000);
+        iters += 10000;
+      }
+      int rt = getrticks();
+      write(fds[k][1], &iters, sizeof(iters));
+      write(fds[k][1], &rt, sizeof(rt));
+      exit(0);
+    }
+  }
+  for (int k = 0; k < 3; k++) {
+    long iters;
+    int rt;
+    read(fds[k][0], &iters, sizeof(iters));
+    read(fds[k][0], &rt, sizeof(rt));
+    wait(0);
+    printf("R share tickets=%d iters_k=%d cpu_ticks=%d\n", tick[k], (int)(iters / 1000), rt);
+  }
+}
+
+static void
+workload_mixed(void)
+{
+  int T = 600;
+  int start = uptime();
+  for (int k = 0; k < 2; k++) {
+    if (fork() == 0) {
+      while (uptime() - start < T)
+        spin(10000);
+      exit(0);
+    }
+  }
+  int fd[2];
+  pipe(fd);
+  if (fork() == 0) {                              // interactive: sleep 2 ticks, then 1 tick of work, repeat
+    int n = 0, lat_sum = 0, lat_max = 0;
+    while (uptime() - start < T) {
+      int t0 = uptime();
+      pause(2);                                   // this xv6 version calls the sleep system call "pause"
+      int back = uptime();
+      spin_ticks(1);
+      int lat = back - t0 - 2;                    // wake-up delay beyond the 2-tick sleep
+      lat_sum += lat > 0 ? lat : 0;
+      if (lat > lat_max)
+        lat_max = lat;
+      n++;
+    }
+    write(fd[1], &n, sizeof(n));
+    write(fd[1], &lat_sum, sizeof(lat_sum));
+    write(fd[1], &lat_max, sizeof(lat_max));
+    exit(0);
+  }
+  int n, ls, lm;
+  read(fd[0], &n, sizeof(n));
+  read(fd[0], &ls, sizeof(ls));
+  read(fd[0], &lm, sizeof(lm));
+  wait(0);
+  wait(0);
+  wait(0);
+  printf("R mixed interactive_iterations=%d mean_wakeup_delay_x100=%d max_delay=%d\n", n, n ? 100 * ls / n : -1, lm);
+}
+
+static void
+workload_jobs(void)
+{
+  int len[6] = {10, 20, 40, 60, 80, 100};         // job lengths in ticks of solo CPU time (sum 310)
+  int fds[6][2];
+  int start = uptime();
+  for (int k = 0; k < 6; k++) {
+    pipe(fds[k]);
+    if (fork() == 0) {
+      int first = uptime() - start;               // when the job first got the CPU (response time)
+      spin_ticks(len[k]);
+      int done = uptime() - start;                // turnaround (all jobs arrive at time 0)
+      write(fds[k][1], &first, sizeof(first));
+      write(fds[k][1], &done, sizeof(done));
+      exit(0);
+    }
+  }
+  int sum_t = 0, sum_r = 0, mk = 0;
+  for (int k = 0; k < 6; k++) {
+    int first, done;
+    read(fds[k][0], &first, sizeof(first));
+    read(fds[k][0], &done, sizeof(done));
+    wait(0);
+    printf("R job len=%d response=%d turnaround=%d\n", len[k], first, done);
+    sum_t += done;
+    sum_r += first;
+    if (done > mk)
+      mk = done;
+  }
+  printf("R jobs_summary mean_turnaround_x10=%d mean_response_x10=%d makespan=%d\n", sum_t * 10 / 6, sum_r * 10 / 6, mk);
+}
+
+int
+main(int argc, char *argv[])
+{
+  if (argc != 3) {
+    fprintf(2, "usage: schedbench policy share|mixed|jobs\n");
+    exit(1);
+  }
+  int pol = atoi(argv[1]);
+  calibrate();
+  if (setsched(pol) < 0)
+    exit(1);
+  printf("R begin policy=%d workload=%s iters_per_tick=%d\n", pol, argv[2], iters_per_tick);
+  if (strcmp(argv[2], "share") == 0)
+    workload_share();
+  else if (strcmp(argv[2], "mixed") == 0)
+    workload_mixed();
+  else
+    workload_jobs();
+  setsched(0);
+  printf("R done\n");
+  exit(0);
+}
