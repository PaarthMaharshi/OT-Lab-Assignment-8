+#ifndef _PSTAT_H_
+#define _PSTAT_H_
+#define PSTAT_NPROC 64   // must equal NPROC in param.h
+
+// Snapshot of per-process scheduling statistics returned by getpinfo().
+struct pstat {
+  int inuse[PSTAT_NPROC];     // slot in use (state != UNUSED)
+  int pid[PSTAT_NPROC];
+  int tickets[PSTAT_NPROC];
+  int level[PSTAT_NPROC];     // MLFQ level
+  uint64 rticks[PSTAT_NPROC]; // timer ticks spent running
+  uint64 nsched[PSTAT_NPROC]; // times scheduled
+};
+#endif
