+// ---- Track G: scheduling policies ----
+#include "pstat.h"
+
+static uint64 rngstate = 88172645463325252ULL;
+
+// xorshift64: small deterministic PRNG for the lottery scheduler
+static uint
+sched_rand(void)
+{
+  rngstate ^= rngstate << 13;
+  rngstate ^= rngstate >> 7;
+  rngstate ^= rngstate << 17;
+  return (uint)(rngstate >> 32);
+}
+
+// Fill a snapshot of scheduling statistics (used by getpinfo).
+int
+fill_pstat(struct pstat *st)
+{
+  for (int i = 0; i < NPROC; i++) {
+    struct proc *p = &proc[i];
+    acquire(&p->lock);
+    st->inuse[i] = p->state != UNUSED;
+    st->pid[i] = p->pid;
+    st->tickets[i] = p->tickets;
+    st->level[i] = p->level;
+    st->rticks[i] = p->rticks;
+    st->nsched[i] = p->nsched;
+    release(&p->lock);
+  }
+  return 0;
+}
+
+// Choose the next process for policy 1 (lottery) or 2 (MLFQ).
+// Returns with the chosen process's lock held and state RUNNABLE, or 0 if nothing can run.
+// (Written for one CPU: it does not try to stay consistent if another CPU steals a process.)
+static struct proc *
+pick_proc(void)
+{
+  struct proc *p;
+  if (sched_policy == 1) {
+    for (;;) {
+      int total = 0;
+      for (p = proc; p < &proc[NPROC]; p++) {
+        acquire(&p->lock);
+        if (p->state == RUNNABLE)
+          total += p->tickets;
+        release(&p->lock);
+      }
+      if (total == 0)
+        return 0;
+      int winner = sched_rand() % total, acc = 0;
+      for (p = proc; p < &proc[NPROC]; p++) {
+        acquire(&p->lock);
+        if (p->state == RUNNABLE) {
+          acc += p->tickets;
+          if (acc > winner)
+            return p;
+        }
+        release(&p->lock);
+      }
+    }
+  }
+  // MLFQ: periodically boost everyone to the top queue (prevents starvation)
+  static uint last_boost = 0;
+  if (ticks - last_boost >= 50) {
+    for (p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      p->level = 0;
+      p->qticks = 0;
+      release(&p->lock);
+    }
+    last_boost = ticks;
+  }
+  int best = 99;
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state == RUNNABLE && p->level < best)
+      best = p->level;
+    release(&p->lock);
+  }
+  if (best == 99)
+    return 0;
+  static int last = 0;
+  for (int i = 1; i <= NPROC; i++) {                 // round robin inside the chosen level
+    int idx = (last + i) % NPROC;
+    p = &proc[idx];
+    acquire(&p->lock);
+    if (p->state == RUNNABLE && p->level == best) {
+      last = idx;
+      return p;
+    }
+    release(&p->lock);
+  }
+  return 0;
+}
