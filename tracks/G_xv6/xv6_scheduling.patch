+// setpolicy N: select the kernel scheduling policy (0 round robin, 1 lottery, 2 MLFQ).
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if (argc != 2) {
+    fprintf(2, "usage: setpolicy 0|1|2\n");
+    exit(1);
+  }
+  if (setsched(atoi(argv[1])) < 0) {
+    fprintf(2, "setpolicy: bad policy\n");
+    exit(1);
+  }
+  exit(0);
+}
