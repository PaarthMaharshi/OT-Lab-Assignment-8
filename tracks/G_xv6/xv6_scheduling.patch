+
+// ---- Track G: scheduling system calls ----
+#include "pstat.h"
+extern int sched_policy;
+extern int fill_pstat(struct pstat *);
+static struct pstat kpstat;   // static: too big for the 4 KB kernel stack
+
+// settickets(n): give the calling process n lottery tickets (n >= 1).
+uint64
+sys_settickets(void)
+{
+  int n;
+  argint(0, &n);
+  if(n < 1)
+    return -1;
+  struct proc *p = myproc();
+  acquire(&p->lock);
+  p->tickets = n;
+  release(&p->lock);
+  return 0;
+}
+
+// setsched(policy): 0 = round robin (original xv6), 1 = lottery, 2 = MLFQ.
+uint64
+sys_setsched(void)
+{
+  int pol;
+  argint(0, &pol);
+  if(pol < 0 || pol > 2)
+    return -1;
+  sched_policy = pol;
+  return 0;
+}
+
+// getpinfo(struct pstat *): copy scheduling statistics of all processes to user space.
+uint64
+sys_getpinfo(void)
+{
+  uint64 addr;
+  argaddr(0, &addr);
+  fill_pstat(&kpstat);
+  struct proc *p = myproc();
+  if(copyout(p->pagetable, p->sz, addr, (char *)&kpstat, sizeof(kpstat)) < 0)
+    return -1;
+  return 0;
+}
